# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development
# Leave SECRET_KEY empty in development (a random key is generated once into data/.secret_key).
# REQUIRED in production:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is the default. For PostgreSQL use:  postgresql+psycopg://user:password@localhost:5432/pneumovision
# DATABASE_URL=sqlite:///./data/app.db

MAX_UPLOAD_MB=10
INFERENCE_DEVICE=auto

# Optional overrides (defaults live under ./data)
# DATASET_DIR=./data/raw/chest_xray
# ARTIFACTS_DIR=./data/artifacts
# MEDIA_DIR=./data/media

# Used only by docker-compose
POSTGRES_PASSWORD=change-me-please
